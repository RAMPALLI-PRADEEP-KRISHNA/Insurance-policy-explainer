# Google Gemini API Configuration (Required for later generation phases)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OCR & Ingestion Settings
OCR_THRESHOLD=0.15
OCR_DPI=300
# Optional explicit path to tesseract binary if not in system PATH
# e.g., C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Document Constraints
MAX_PDF_PAGES=300
MAX_FILE_SIZE_MB=50

# Chunking Configuration (for chunking phase)
MAX_CHUNK_CHARS=800
OVERLAP_CHARS=160

# Retrieval & Evidence Thresholds (for retrieval phase)
EVIDENCE_HIGH_THRESHOLD=0.65
EVIDENCE_LOW_THRESHOLD=0.40

# Logging
LOG_LEVEL=INFO

# LLM Configuration
LLM_PROVIDER=mistral
LLM_FALLBACK_PROVIDER=gemini
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
LLM_REQUEST_TIMEOUT_SECONDS=15
LLM_TOTAL_DEADLINE_SECONDS=40

