# Primary & Fallback LLM Provider Configuration
LLM_PROVIDER=mistral
LLM_FALLBACK_PROVIDER=gemini
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=ministral-8b-latest
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
LLM_REQUEST_TIMEOUT_SECONDS=15
LLM_TOTAL_DEADLINE_SECONDS=30

# Vector Database (Local disk default; Qdrant Cloud is optional)
VECTOR_STORE_BACKEND=qdrant
QDRANT_COLLECTION_NAME=insurance_policy_chunks
# QDRANT_URL=https://your-cluster-url.qdrant.tech
# QDRANT_API_KEY=your_qdrant_cloud_api_key

# OCR & Ingestion Settings
OCR_THRESHOLD=0.15
OCR_DPI=300
# Optional explicit path to tesseract binary if not in system PATH
# e.g., C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Document Constraints
MAX_PDF_PAGES=300
MAX_FILE_SIZE_MB=50

# Chunking Configuration
MAX_CHUNK_CHARS=800
OVERLAP_CHARS=160

# Retrieval & Evidence Thresholds
EVIDENCE_HIGH_THRESHOLD=0.65
EVIDENCE_LOW_THRESHOLD=0.40

# Logging
LOG_LEVEL=INFO
